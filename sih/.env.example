# =============================================================================
# NER-LIFELINE Environment Template
# Copy to `.env.local` for local development. Never commit real secrets.
# =============================================================================

# ---- Authentication (Firebase Auth — browser SDK) ----
# Leave EMPTY to run in offline demo mode (static demo personas).
# Fill them in to enable Google Sign-In + email/password authentication.
# Console: Project settings → General → Your apps → SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# =============================================================================
# Live Data API Keys (OPTIONAL — leave blank for offline/mock mode)
# All of these are optional. When absent, the app gracefully falls back to
# curated local datasets. Configure them to pull REAL data from live services.
# NEVER expose these in client-side code — they are read only in server-side
# route handlers.
# =============================================================================

# ---- Google Routes API v2 (server-side only) ----
# Used by: POST /api/v1/routes/google, POST /api/routes/alternate
# Provides: real corridor routing, distance, duration, risk assessment
# Console: https://console.cloud.google.com/apis/credentials
# Enable API: "Routes API" in Google Cloud Console
GOOGLE_ROUTES_API_KEY=

# ---- SerpApi / Google Places (server-side only) ----
# Used by: GET /api/places
# Provides: real fuel stations, hospitals, coffee shops near a location
# SerpApi: https://serpapi.com/  |  Google Places: https://developers.google.com/maps/documentation/places/web-service
# If both are set, SerpApi takes priority.
SERP_API_KEY=
GOOGLE_MAPS_API_KEY=

# ---- LLM Provider for AI Copilot (server-side only) ----
# Used by: POST /api/chat, GET /api/chat/suggestions
# Provides: real conversational AI responses instead of template answers
# Set ONE provider (OpenAI preferred, Google Generative AI as fallback):
OPENAI_API_KEY=
GOOGLE_GENERATIVE_API_KEY=

# ---- Fleet Telemetry Backend (server-side proxy) ----
# Used by: GET /api/vehicles
# Provides: real-time AIS-140 vehicle positions, speed, status
# URL of your FastAPI/vehicle-tracking backend
FLEET_BACKEND_URL=
FLEET_API_KEY=

# ---- MoRTH VAHAN 4.0 Verification (server-side only) ----
# Used by: GET /api/vahan/verify/{plate}
# Provides: real vehicle registration verification from Parivahan
# Requires MoRTH developer registration for API access token
PARIVAHAN_API_TOKEN=

# ---- Weather Data (server-side only) ----
# Used by: GET /api/weather  (new endpoint for real weather conditions)
# Provides: real-time weather conditions and precipitation radar
# OpenWeatherMap: https://openweathermap.org/api
OPENWEATHER_API_KEY=
