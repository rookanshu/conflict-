# =============================================================================
# Unified NER-LIFELINE — environment template
# Copy to `.env.local` for local development. Never commit real secrets.
# =============================================================================

# ---- API layer (server-side, consumed by the Next.js route handlers) ----
# Where the unified FastAPI engine (sih/backend/main.py) listens.
BACKEND_URL=http://127.0.0.1:8000
# Set to "false" to run fully self-contained on the curated offline datasets.
BACKEND_ENABLED=true
# Upstream budget (ms) before a handler degrades to its fallback dataset.
BACKEND_TIMEOUT_MS=3500

# ---- Authentication (Firebase Auth — browser SDK) ----
# These are Firebase *web app* identifiers, not server secrets, but they are
# still read from the environment only — never hardcoded, never committed.
# Leave them EMPTY to run the app in offline demo mode (static demo personas).
# Fill them in to enable Google Sign-In + e-mail/passphrase authentication.
# Console: Project settings → General → Your apps → SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Backend credentials (belong in sih/backend/.env — NEVER expose to the browser) ----
# GOOGLE_ROUTES_API_KEY is used by the FastAPI engine for the Google Routes API v2.
GOOGLE_ROUTES_API_KEY=
# Enables the server-side Google Maps Places Text Search. Restrict this key to
# the Places API (New); never expose it with a NEXT_PUBLIC_ prefix.
GOOGLE_MAPS_API_KEY=
# Supabase PostgreSQL (operational telemetry, VAHAN register).
SUPABASE_URL=
SUPABASE_ANON_KEY=
